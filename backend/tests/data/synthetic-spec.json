{
  "schema_version": 1,
  "row_count": 20,
  "seed": 42,
  "columns": [
    {"name": "order_id", "type": "string", "nullable_fraction": 0,
     "generator": {"kind": "sequence", "start": 1, "step": 1, "prefix": "ORD-"}},
    {"name": "line_no", "type": "integer", "nullable_fraction": 0,
     "generator": {"kind": "sequence", "start": 10, "step": 10, "prefix": ""}},
    {"name": "store_code", "type": "string", "nullable_fraction": 0,
     "generator": {"kind": "choice", "values": ["001", "002", "010"]}},
    {"name": "order_date", "type": "date", "nullable_fraction": 0.1,
     "generator": {"kind": "date", "start": "2025-01-01", "end": "2025-12-31"}},
    {"name": "region", "type": "string", "nullable_fraction": 0.1,
     "generator": {"kind": "choice", "values": ["East", "West", "South, \"Central\""]}},
    {"name": "country", "type": "string", "nullable_fraction": 0,
     "generator": {"kind": "lookup", "field": "region",
                   "mapping": {"East": "Japan", "West": "Spain", "South, \"Central\"": "Chile"}}},
    {"name": "region_rank", "type": "integer", "nullable_fraction": 0,
     "generator": {"kind": "lookup", "field": "region",
                   "mapping": {"East": 1, "West": 2, "South, \"Central\"": 3}}},
    {"name": "quantity", "type": "integer", "nullable_fraction": 0.2,
     "generator": {"kind": "integer", "min": 1, "max": 8}},
    {"name": "unit_price", "type": "number", "nullable_fraction": 0,
     "generator": {"kind": "decimal", "min": 10, "max": 100, "decimals": 2}},
    {"name": "revenue", "type": "number", "nullable_fraction": 0,
     "generator": {"kind": "product", "fields": ["quantity", "unit_price"], "decimals": 2}},
    {"name": "discount", "type": "number", "nullable_fraction": 0,
     "generator": {"kind": "decimal", "min": -5, "max": 0, "decimals": 1}},
    {"name": "priority", "type": "number", "nullable_fraction": 0,
     "generator": {"kind": "choice", "values": [1, 2.5, 4]}},
    {"name": "returned", "type": "boolean", "nullable_fraction": 0,
     "generator": {"kind": "boolean", "true_probability": 0.25}},
    {"name": "channel", "type": "string", "nullable_fraction": 0.5,
     "generator": {"kind": "choice", "values": ["web", "store"]}}
  ]
}
