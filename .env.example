# Copy to .env at the repo root and fill in. Names and defaults: contracts/conventions.md.
# Never commit .env. Secrets stay empty here.

# --- LLM (backend) ---
GOOGLE_API_KEY=
DSS_PLANNER_MODEL=gemini-4-argon
DSS_WORKER_MODEL=gemini-3.8-flash

# --- Google Cloud (backend, engine) ---
GCP_PROJECT_ID=
BQ_DATASET=dss_demo
BQ_LOCATION=US
GCS_BUCKET=
# Cloud Run region, Artifact Registry and the state bucket (release deploy)
GCP_REGION=asia-southeast1

# --- Runtime files (paths relative to a part folder) ---
DSS_DATA_DIR=../data
# Empty = <DSS_DATA_DIR>/dss.sqlite
DSS_DB_PATH=

# --- Engine: Chrome and runs ---
# Empty = auto-detect the installed Chrome
DSS_CHROME_PATH=
DSS_CHROME_PROFILE=../.chrome-profile
DSS_CDP_PORT=9222
DSS_TEMPLATE_REPORT_ID=
DSS_ENGINE_CMD="uv run --project ../engine dsengine"
DSS_ENGINE_TIMEOUT_S=600
# 1 = add --dry-run to every engine run (no Data Studio)
DSS_ENGINE_DRY_RUN=0
# local = the backend runs the engine; agent = builds are queued for dss-agent (Cloud Run)
DSS_ENGINE_MODE=local

# --- Backend behaviour ---
DSS_ALLOWED_TYPES=scorecard,time_series,area,bar,pie,table,pivot_table,geo_map,scatter,text,image,date_range,dropdown,fixed_size_list
DSS_CONSOLIDATE_EVERY=5
# 1 mounts the /api/dev/* test helpers; never on Cloud Run
DSS_DEV=
PORT=8000
# Built frontend folder served at / (empty = serve no frontend)
DSS_STATIC_DIR=

# --- Access and the build agent ---
# Shared access code, at least 12 characters (empty = no gate)
DSS_ACCESS_CODE=
# Retired (conventions 1.7: per-job codes); read by backends before 29.1 only, no longer deployed
DSS_AGENT_TOKEN=
# Hosted app URL the build agent pulls jobs from (https://<service>-<hash>.<region>.run.app)
DSS_AGENT_SERVER=

# --- Google sign-in and deploy guard (conventions 1.5) ---
# OAuth 2.0 Web client id for Google sign-in at the gate (empty = no Google sign-in; needs DSS_ACCESS_CODE)
GOOGLE_OAUTH_CLIENT_ID=
# Who may sign in with Google: empty or * = any account, else a comma list of @domain and emails
DSS_SIGNIN_ALLOW=
# Cloud Run only (conventions 1.6): 1 = open hosted link, no gate (code and client id empty); empty = gated
DSS_PUBLIC=
# Project number the deploy guard expects; only in .env, never in a tracked file
GCP_PROJECT_NUMBER=

# --- Hosted share data (conventions 1.7; Cloud Run, set by deploy from release 4.5) ---
# Bucket name (no gs://) for each hosted run's public-read CSV; needs DSS_SHARE_DIR
DSS_SHARE_BUCKET=
# Local folder where DSS_SHARE_BUCKET is mounted (Cloud Run: /share)
DSS_SHARE_DIR=
